<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tavall.hytale</groupId>
        <artifactId>tavall-hytale-resource-game</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tavall-resource-game-core</artifactId>
    <packaging>jar</packaging>

    <name>Tavall Resource Game Core</name>
    <description>Core resource game runtime, middleware, Hytale plugin runtime, persistence, and tests.</description>

    <dependencies>
        <dependency>
            <groupId>com.tavall</groupId>
            <artifactId>tavall-resource-game-shared-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tavall</groupId>
            <artifactId>tavall-resource-game-hytale-frontend</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-di</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-eventbus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-concurrency</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-reflection</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tavall</groupId>
            <artifactId>abstract-cache-semantic</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tavall</groupId>
            <artifactId>abstract-cache-storage-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tavall</groupId>
            <artifactId>abstract-cache-storage-postgres</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tavall</groupId>
            <artifactId>abstract-cache-storage-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hypixel.hytale</groupId>
            <artifactId>Server</artifactId>
            <version>${hytale.server.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>curse.maven</groupId>
            <artifactId>hyui-1431415</artifactId>
            <version>${hyui.curse.file}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-parameter-names</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgres.version}</version>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>5.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>tavall-hytale-resource-game</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>manifest.json</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>manifest.json</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>-XX:TieredStopAtLevel=1</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>com.hypixel.hytale.logger.backend.HytaleLogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>com.hypixel.hytale:Server</artifact>
                                    <excludes>
                                        <exclude>**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
