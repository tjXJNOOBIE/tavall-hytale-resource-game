<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tavall</groupId>
        <artifactId>tavall-java-hytale-games</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.tavall.hytale</groupId>
    <artifactId>tavall-hytale-resource-game</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Tavall Hytale Resource Game Parent</name>
    <description>Parent aggregator for Tavall Resource Game core, frontends, control plane, and app surfaces.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hytale.server.version>2026.03.26-89796e57b</hytale.server.version>
        <plugin.main.class>com.tavall.hytale.resourcegame.ResourceGamePlugin</plugin.main.class>
        <jackson.version>2.18.3</jackson.version>
        <postgres.version>42.7.10</postgres.version>
        <junit.version>5.11.4</junit.version>
        <spring.boot.version>3.5.6</spring.boot.version>
        <hyui.curse.file>7820303</hyui.curse.file>
    </properties>

    <modules>
        <module>tavall-resource-game-shared-contracts</module>
        <module>tavall-resource-game-hytale-frontend</module>
        <module>tavall-resource-game-core</module>
        <module>tavall-resource-game-control-server</module>
        <module>tavall-resource-game-minecraft-frontend</module>
        <module>tavall-resource-game-minecraft-server-frontend</module>
        <module>tavall-resource-game-roblox-frontend</module>
        <module>tavall-resource-game-discord-frontend</module>
        <module>tavall-resource-game-android-app</module>
        <module>tavall-resource-game-pc-app</module>
    </modules>

    <repositories>
        <repository>
            <id>codemc-hytale</id>
            <url>https://repo.codemc.io/repository/hytale/</url>
        </repository>
        <repository>
            <id>cursemaven</id>
            <url>https://www.cursemaven.com</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigot-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>
</project>
