<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tavall</groupId>
        <artifactId>tavall-java-hytale-games</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>tavall-resource-game-control-server</artifactId>
    <packaging>jar</packaging>

    <name>Tavall Resource Game Control Server</name>
    <description>Canonical middleware/control-server runtime entrypoint for resource game frontends.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tavall.hytale</groupId>
            <artifactId>tavall-hytale-resource-game</artifactId>
            <version>0.1.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.tavall</groupId>
            <artifactId>tavall-resource-game-shared-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tavall</groupId>
            <artifactId>tavall-resource-game-hytale-frontend</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tavall</groupId>
            <artifactId>tavall-resource-game-minecraft-frontend</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tavall</groupId>
            <artifactId>tavall-resource-game-roblox-frontend</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tavall</groupId>
            <artifactId>tavall-resource-game-discord-frontend</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-di</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-eventbus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-concurrency</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tjxjnoobie</groupId>
            <artifactId>tavall-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tavall</groupId>
            <artifactId>abstract-cache-semantic</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.tavall</groupId>
            <artifactId>abstract-cache-storage-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
